# Copy to apps/web/.env. Bun auto-loads it when running scripts in apps/web.
# Better Auth owns the `auth` schema in this database (search_path is set in
# src/lib/auth.ts). Run `bun run auth:migrate` once to create its tables.
DATABASE_URL=postgres://unghosted:unghosted@localhost:5432/unghosted
# 32+ random bytes. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Also the JWT issuer and audience the Python API checks (ADR 0002).
BETTER_AUTH_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
