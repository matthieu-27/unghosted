# Copy to apps/api/.env (git-ignored). Same values work for the worker.
# Ports match the compose defaults — the root .env may map 5433/27018 on
# machines where a native Postgres already owns 5432.
UNGHOSTED_DATABASE_URL=postgresql+asyncpg://unghosted:unghosted@localhost:5432/unghosted
UNGHOSTED_MONGO_URL=mongodb://unghosted:unghosted@localhost:27017
# Better Auth (apps/web) issues the API's JWTs. These defaults match the web
# app on http://localhost:3000; deployments point them at the real base URL.
# UNGHOSTED_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# UNGHOSTED_AUTH_ISSUER=http://localhost:3000
# UNGHOSTED_AUTH_AUDIENCE=http://localhost:3000
# UNGHOSTED_AUTH_LEEWAY_SECONDS=5
# Master key for envelope-encrypting stored documents: 32 random bytes,
# base64. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
UNGHOSTED_MASTER_KEY=
# Optional overrides:
# UNGHOSTED_MONGO_DATABASE=unghosted
# UNGHOSTED_SHARED_TEMPLATES_DIR=/absolute/path/to/packages/shared/templates
# UNGHOSTED_CORS_ORIGINS=["http://localhost:3000"]
# Document storage: "local" (default) or "s3".
# UNGHOSTED_STORAGE_BACKEND=local
# UNGHOSTED_STORAGE_DIR=var/storage
# Required when UNGHOSTED_STORAGE_BACKEND=s3:
# UNGHOSTED_S3_BUCKET=
# UNGHOSTED_S3_ENDPOINT_URL=
# UNGHOSTED_S3_REGION=
# Outbound mail. Defaults target the compose mailpit service (inbox UI on
# http://localhost:8025). The sender identity moves to the user's own
# mailbox post-MVP.
# UNGHOSTED_SMTP_HOST=localhost
# UNGHOSTED_SMTP_PORT=1025
# UNGHOSTED_SMTP_TIMEOUT_SECONDS=10
# UNGHOSTED_MAIL_FROM=applicant@example.com
# UNGHOSTED_DAILY_SEND_CAP=10
# UNGHOSTED_SEND_TIMEZONE=Europe/Paris
